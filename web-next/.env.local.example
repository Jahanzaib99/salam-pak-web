# Vercel AI Gateway key (recommended) — enables LLM-powered Rehbar.
# Without this key, Rehbar still answers from the local destination + FAQ knowledge base.
AI_GATEWAY_API_KEY=

# Optional direct OpenAI key (fallback auth detection only; prefer AI Gateway).
# OPENAI_API_KEY=

# CARTO API key — destination surroundings basemap / CARTO services.
CARTO_API_KEY=

# Optional Google Maps Places key (AIza…) for POI search. Falls back to OpenStreetMap.
# GOOGLE_MAPS_API_KEY=
